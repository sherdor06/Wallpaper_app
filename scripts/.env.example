# Cloudflare R2 kredensiallari (.env ga nusxa oling: cp .env.example .env)
# Bularni Cloudflare dashboard > R2 > Manage API Tokens dan olasiz (README A-qism).

# R2 account ID (dashboard URL'idagi yoki R2 sahifasidagi 32 belgili ID)
R2_ACCOUNT_ID=your_account_id_here

# API token yaratganda chiqadigan kalitlar
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Bucket nomi (masalan: wallpapers)
R2_BUCKET=wallpapers

# --- Openverse (fetch_stock.py — CC0/PDM foto yig'ish) — IXTIYORIY ---
# Anonim ham ishlaydi, lekin limit 200/kun. Bulk uchun bepul token oling:
# https://api.openverse.org/v1/auth_tokens/register/ (client_id + secret qaytaradi)
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
