<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Android 13+ gates notifications behind a runtime prompt. PushService
         asks for it only after the user has applied a couple of wallpapers —
         a prompt on first launch is mostly denied, and Android gives one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Wavely"
        android:icon="@mipmap/ic_launcher">

        <!-- No ad-network meta-data here: Yandex Mobile Ads is identified by
             the ad unit id on each request, unlike AdMob which required its app id
             in the manifest. -->

        <!-- Jonli (video) wallpaper servisi. -->

        <service
            android:name="com.sherdor.wallpapers.LiveWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>


        <service
            android:name="com.sherdor.wallpapers.WorldWallpaperService"
            android:label="@string/world_wallpaper_name"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper"
                android:resource="@xml/world_wallpaper" />
        </service>

        <!-- FQCN: paket nomi bilan to‘liq -->
        <activity
            android:name="com.sherdor.wallpapers.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Shared wallpaper links. autoVerify makes Android fetch
                 https://wallpapers-cdn.pages.dev/.well-known/assetlinks.json and,
                 if this app's signing fingerprint is listed there, open these
                 URLs directly instead of offering a chooser. Until that file
                 lists the *Play* signing key (not the upload key), verification
                 fails and the user gets the chooser — the link still works,
                 it just asks first.

                 Keep the host and prefix in step with DeepLinkService. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="wallpapers-cdn.pages.dev"
                    android:pathPrefix="/w/"/>
            </intent-filter>

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <meta-data android:name="flutterEmbedding" android:value="2" />

        <!-- Push. A message that arrives while the app is in the background is
             drawn by FCM itself, from these defaults. Without the channel it
             falls back to "Miscellaneous", whose default importance never pops
             up over the screen; without the icon, Android tints the
             full-colour launcher icon into a white square. MainActivity
             creates the channel. A message that arrives with the app open goes
             to the app instead and is not drawn at all. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>
</manifest>
